generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id Int @id @default(autoincrement())
  name String
  slug String @unique
  image String?
  images String @default("[]")
  category String
  subcategory String?
  regularPrice Float
  salePrice Float
  discount Int @default(0)
  stock Int @default(0)
  sku String @unique
  details String?
  sizes String @default("[]")
  colors String @default("[]")
  variants String @default("[]")
  active Boolean @default(true)
  featured Boolean @default(false)
  offer Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id Int @id @default(autoincrement())
  name String @unique
  slug String @unique
  active Boolean @default(true)
  sortOrder Int @default(0)
  subcategories Subcategory[]
  createdAt DateTime @default(now())
}
model Subcategory {
  id Int @id @default(autoincrement())
  name String
  slug String
  active Boolean @default(true)
  sortOrder Int @default(0)
  categoryId Int
  category Category @relation(fields:[categoryId], references:[id], onDelete:Cascade)
  @@unique([categoryId,name])
}

model Banner {
  id Int @id @default(autoincrement())
  title String
  subtitle String?
  image String
  buttonText String? @default("পণ্য দেখুন")
  buttonLink String? @default("/#products")
  active Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
}

model DeliveryArea {
  id Int @id @default(autoincrement())
  name String @unique
  charge Float @default(80)
  active Boolean @default(true)
  sortOrder Int @default(0)
}

model Customer {
  id Int @id @default(autoincrement())
  name String
  phone String
  email String?
  address String?
  note String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  orders Order[]
}

model Order {
  id Int @id @default(autoincrement())
  orderNo String @unique
  customerId Int
  customer Customer @relation(fields:[customerId], references:[id])
  status String @default("PENDING")
  subtotal Float
  deliveryFee Float @default(0)
  total Float
  paymentMethod String?
  paymentRef String?
  deliveryArea String?
  address String?
  note String?
  items String @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id Int @id @default(1)
  storeName String @default("সহজ সদাই বিডি")
  logo String?
  banner String?
  phone String @default("01637816210")
  whatsapp String @default("01637816210")
  email String @default("sohozsodai@gmail.com")
  bkash String @default("01637816210")
  nagad String @default("01637816210")
  facebook String @default("https://web.facebook.com/sohozzsodaibd/")
  deliveryCharge Float @default(80)
  theme String @default("green")
  heroTitle String @default("প্রয়োজনীয় পণ্য এখন আরও সহজে")
  heroSubtitle String @default("সহজ সদাই বিডি থেকে প্রয়োজনীয় পণ্য অর্ডার করুন। ভালো দাম, সহজ অর্ডার এবং দ্রুত ডেলিভারি।")
  heroBadge String @default("বিশ্বস্ত অনলাইন শপ")
  productSectionTitle String @default("আমাদের জনপ্রিয় পণ্য")
  featuredSectionTitle String @default("Featured পণ্য")
  offerSectionTitle String @default("আজকের অফার")
  footerText String @default("সহজ সদাই বিডি — আপনার বিশ্বস্ত অনলাইন শপ")
}
